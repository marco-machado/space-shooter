{
  "name": "space-shooter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write src/ *.js *.json *.md",
    "format:check": "prettier --check src/ *.js *.json *.md",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist/ coverage/ .nyc_output/",
    "validate": "npm run lint src/ && npm run format:check && npm run test",
    "start": "npm run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "canvas": "^3.1.2",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "jsdom": "^26.1.0",
    "phaser3spectorjs": "^0.0.8",
    "prettier": "^3.6.2",
    "terser": "^5.43.1",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "bitecs": "^0.3.40",
    "phaser": "^3.90.0",
    "phaser3-rex-plugins": "^1.80.16"
  }
}
